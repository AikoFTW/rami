# Port the site listens on
PORT=3333

# Your MongoDB connection string (mongoURI, MONGODB_URI or MONGO_URI all work).
# The database name is taken from the end of it (…mongodb.net/rami). Leave it out to use ./data/db.json.
mongoURI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/rami

# Address to listen on. Use 127.0.0.1 if a reverse proxy sits in front of it.
HOST=0.0.0.0

# Set to 1 if you serve the site over https, so login cookies are https-only
SECURE_COOKIES=0

# How many accounts can sign up on the site before sign-up closes
MAX_USERS=2
