# Port the site listens on
PORT=3333

# Your MongoDB connection string. Leave it out to store data in ./data/db.json instead.
MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/?authSource=admin

# Database name inside MongoDB
MONGODB_DB=rami

# Address to listen on. Use 127.0.0.1 if a reverse proxy sits in front of it.
HOST=0.0.0.0

# Set to 1 if you serve the site over https, so login cookies are https-only
SECURE_COOKIES=0

# How many accounts can sign up on the site before sign-up closes
MAX_USERS=2
